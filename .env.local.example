# The three placeholders from the Execution Book (Open Decision 6).
# Copy to .env.local and fill before launch.

# Dashboard endpoint the lead form forwards to (server-side).
LEAD_ENDPOINT=

# Removed by client request — the inquiry form is the sole conversion path.
# WhatsApp and Call buttons no longer exist on the site; these stay only as
# a record in case the decision is reversed.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_CALL_NUMBER=

# GA4 measurement ID. e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Path the confirmation pane's brochure download serves. Defaults to the
# placeholder at /brochure/maison-de-build.pdf — swap the file or point
# this elsewhere; no code change needed.
NEXT_PUBLIC_BROCHURE_PATH=

# ── Scroll-gate lead capture (server-side only) ──────────────────────
# Supabase project kzstcufbmaqalzuqoopm. The service-role key bypasses
# RLS; never expose it to the client.
SUPABASE_URL=https://kzstcufbmaqalzuqoopm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# fast2sms DLT. When FAST2SMS_API_KEY is empty the OTP is logged to the
# server console instead of sent (dev only).
FAST2SMS_API_KEY=
# Optional overrides — defaults match the client's DLT registration.
FAST2SMS_SENDER_ID=TACHIN
FAST2SMS_DLT_TEMPLATE=190690

# Telegram bot notified on each verified lead. Both required for the
# ping to fire; a failure here never blocks verification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── /downloads click counter (server-side only) ───────────────────────
# Build_GYM_Backend's base URL (no trailing slash), e.g. https://api.maisondebuild.com
# Both required for counting; without them /downloads still redirects
# correctly, it just skips the counter (logs a warning).
BUILD_GYM_BACKEND_URL=
# Must match WEBSITE_DOWNLOADS_SECRET in Build_GYM_Backend's env exactly.
WEBSITE_DOWNLOADS_SECRET=
